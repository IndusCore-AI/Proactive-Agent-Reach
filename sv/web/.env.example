# Server-only. Never prefix these with NEXT_PUBLIC_.
# Read token for the VM API (its sha256 is SV_READ_TOKEN_SHA256 in the VM's ~/.config/keeping-up-sv/env).
SV_READ_TOKEN=
# HMAC key and ntfy topic the VM uses to announce its tunnel URL (copied from the VM env file).
SV_ANNOUNCE_SECRET=
SV_NTFY_TOPIC=
# Optional fixed API URL, used when no valid announcement is found (local dev: http://127.0.0.1:8793 over an ssh -L tunnel).
SV_API_URL=
# Movers to watch, founders' view (production only; leave unset on previews and the page stays public-only).
# The founders' desk token (take, scores, votes, stages, publishing); its sha256 is SV_FOUNDERS_TOKEN_SHA256 on the VM. Never the read token.
SV_FOUNDERS_TOKEN=
# sha256 hex of the founders' passphrase (the passphrase itself is never stored).
SV_FOUNDERS_PASSPHRASE_SHA256=
# HMAC key for the sv_founders cookie, at least 32 characters. Rotating it signs every browser out.
SV_UNLOCK_SECRET=
